rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && incoming().uid == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().email is string && incoming().email.size() <= 254;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'birthDate', 'diagnosis', 'emergencyContact', 'updatedAt']);
      allow delete: if false; // Safeguard clinical profile

      // Pain Logs Subcollection
      match /pain_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(logId)
          && incoming().userId == userId
          && incoming().painLevel is number && incoming().painLevel >= 0 && incoming().painLevel <= 10
          && incoming().severityCategory in ['mild', 'moderate', 'severe', 'intense'];
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().painLevel is number && incoming().painLevel >= 0 && incoming().painLevel <= 10;
        allow delete: if isOwner(userId);
      }

      // Medications Subcollection
      match /medications/{medicationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(medicationId)
          && incoming().userId == userId
          && incoming().name is string && incoming().name.size() <= 120
          && incoming().dosage is string && incoming().dosage.size() <= 60;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Medication Intakes Subcollection
      match /medication_intakes/{intakeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(intakeId)
          && incoming().userId == userId
          && incoming().status in ['taken', 'skipped', 'pending'];
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'takenAt', 'dosage']);
        allow delete: if isOwner(userId);
      }

      // Sleep Logs Subcollection
      match /sleep_logs/{sleepId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(sleepId)
          && incoming().userId == userId
          && incoming().durationHours is number && incoming().durationHours >= 0 && incoming().durationHours <= 24
          && incoming().qualityRating is number && incoming().qualityRating >= 1 && incoming().qualityRating <= 5;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Exercise Logs Subcollection
      match /exercise_logs/{exerciseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(exerciseId)
          && incoming().userId == userId
          && incoming().activityType is string
          && incoming().durationMinutes is number && incoming().durationMinutes >= 1
          && incoming().intensity in ['leve', 'moderada', 'intensa'];
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
