@startuml 03-implantacao-vercel
title Implantação na Vercel
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam component {
  BackgroundColor #D9ECE4
  BorderColor #103557
}
skinparam database {
  BackgroundColor #E8F1F5
  BorderColor #103557
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
left to right direction

actor "Usuário" as U
node "Navegador" as B {
  artifact "SPA (HTML, JS, CSS)" as SPA
}

cloud "Vercel" as V {
  component "Hospedagem estática\n(vercel.json: rewrite para /index.html)" as HOST
  artifact "dist/ (npm run build)" as DIST
  component "API intermediária\n(opcional)" as API
  database "Vercel Postgres\n(Neon)" as NEON
}
database "Supabase\n(PostgreSQL)" as SUPA
cloud "Firebase\n(Firestore e Authentication)" as FB

U --> B
B --> HOST : HTTPS
HOST --> DIST
B ..> SUPA : VITE_SUPABASE_URL\nVITE_SUPABASE_ANON_KEY
B ..> FB : VITE_FIREBASE_*
B ..> API : VITE_API_BASE_URL
API --> NEON : POSTGRES_URL

legend bottom
  O banco é uma das três opções:
  Vercel Postgres, Supabase ou Firestore.
  Variáveis configuradas em Settings > Environment Variables.
endlegend
@enduml
