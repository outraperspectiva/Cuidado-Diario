@startuml 02-implantacao-gcp
title Implantação no Google Cloud (GCP)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam component {
  BackgroundColor #D9ECE4
  BorderColor #103557
}
skinparam database {
  BackgroundColor #E8F1F5
  BorderColor #103557
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
left to right direction

actor "Usuário" as U
node "Navegador" as B {
  artifact "SPA (HTML, JS, CSS)" as SPA
}

cloud "Google Cloud" as GCP {
  node "Cloud Run\n(porta 3000)" as CR {
    component "Nginx\n(try_files para a SPA)" as NG
    artifact "dist/ (build Vite)" as DIST
  }
  artifact "Imagem Docker\n(gcr.io/.../cuidado-diario-app)" as IMG
  node "Firebase" as FB {
    component "Authentication" as FA
    database "Firestore" as FS
  }
  component "API Node.js/Express\n(Cloud Run, opcional)" as API
  database "Cloud SQL\n(PostgreSQL 15)" as SQL
}

U --> B
B --> CR : HTTPS
IMG ..> CR : deploy (gcloud run deploy)
NG --> DIST
B --> FA : login
B --> FS : SDK Web\n(regras em firestore.rules)
B ..> API : VITE_API_BASE_URL\n(opcional)
API --> SQL : Cloud SQL Proxy

legend bottom
  Opção 1.1: Firestore + Cloud Run (ou Firebase Hosting).
  Opção 1.2: Cloud SQL + API intermediária.
endlegend
@enduml
