@startuml 01-arquitetura-de-componentes
title Arquitetura lógica de componentes (visão proposta)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam component {
  BackgroundColor #D9ECE4
  BorderColor #103557
}
skinparam database {
  BackgroundColor #E8F1F5
  BorderColor #103557
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
left to right direction

actor "Usuário" as U

package "Aplicativo web (React 18, TypeScript, Vite)" as APP {
  package "Telas" as Telas {
    [Login e privacidade]
    [Hoje]
    [Medicamentos]
    [Fisioterapia]
    [Dor e sintomas]
    [Evolução e relatórios]
    [Consultas]
  }
  [Estado global\n(Redux Toolkit)] as Store
  [Acesso a dados] as Data
  [Exportação de PDF] as Pdf
}

cloud "Provedor de autenticação\n(Google, e-mail e senha)" as Auth
database "Banco de dados\n(Firestore ou PostgreSQL)" as DB
component "API intermediária\n(opcional, Node.js/Express)" as Api

U --> Telas
Telas --> Store
Store --> Data
[Evolução e relatórios] --> Pdf
Data --> Auth : autenticação
Data --> DB : Firestore (SDK Web)
Data ..> Api : se usar PostgreSQL\n(VITE_API_BASE_URL)
Api --> DB : SQL

legend bottom
  Visão lógica proposta a partir do README e dos ADRs.
  A persistência é adaptável (ADR-0004).
endlegend
@enduml
