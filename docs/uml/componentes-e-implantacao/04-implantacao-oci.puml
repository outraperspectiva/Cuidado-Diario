@startuml 04-implantacao-oci
title Implantação no Oracle Cloud (OCI)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam component {
  BackgroundColor #D9ECE4
  BorderColor #103557
}
skinparam database {
  BackgroundColor #E8F1F5
  BorderColor #103557
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
left to right direction

actor "Usuário" as U
node "Navegador" as B {
  artifact "SPA (HTML, JS, CSS)" as SPA
}

cloud "Oracle Cloud (OCI)" as OCI {
  node "VCN\n(regras de entrada: portas 80, 443 e 3000)" as VCN {
    node "VM Compute (Always Free)\nUbuntu 22.04" as VM {
      component "Nginx\n(estáticos e reverse proxy)" as NG
      component "Certbot\n(certificado HTTPS)" as CB
      artifact "dist/ (npm run build)" as DIST
      component "API Node.js\n(opcional)" as API
    }
    database "Autonomous Database\n(Always Free)" as ADB
    database "OCI Database with PostgreSQL\n(porta 5432, rede privada)" as PG
  }
}

U --> B
B --> NG : HTTPS (443)
NG --> DIST
CB ..> NG : renova o certificado
B ..> API : VITE_API_BASE_URL\n(opcional)
API --> ADB : driver oracledb
API --> PG : SQL

legend bottom
  O banco é uma das opções: Autonomous Database
  ou PostgreSQL gerenciado.
endlegend
@enduml
