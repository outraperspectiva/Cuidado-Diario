@startuml 03-dor-e-consultas
title Dor, sintomas e consultas (PRD-0004 e PRD-0005)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #103557
  HeaderBackgroundColor #D9ECE4
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
hide empty members

enum AppointmentStatus {
  scheduled
  completed
  canceled
}
class User {
  uid : string <<PK>>
}
class PainLog {
  id : string <<PK>>
  userId : string <<FK>>
  level : int [0..10]
  location : string
  type : string
  isCrisis : boolean
  timestamp : datetime
}
class Appointment {
  id : string <<PK>>
  userId : string <<FK>>
  doctorName : string
  specialty : string
  date : date
  time : string
  location : string
  status : AppointmentStatus
}

User "1" -- "0..*" PainLog : registra
User "1" -- "0..*" Appointment : agenda
Appointment --> AppointmentStatus

note right of PainLog
  Pontos em aberto: critério para marcar
  "isCrisis" (decisão D3) e campo para os
  fatores desencadeantes.
end note
@enduml
