@startuml 02-fisioterapia
title Fisioterapia e reabilitação (PRD-0003)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #103557
  HeaderBackgroundColor #D9ECE4
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
hide empty members

enum ExecutionStatus {
  pending
  completed
}
class User {
  uid : string <<PK>>
}
class PhysiotherapyPrescription {
  id : string <<PK>>
  userId : string <<FK>>
  title : string
  scheduledTimes : string[]
  sets : int
  repetitions : int
  holdTimeSeconds : int
}
class PhysiotherapyExecution {
  id : string <<PK>>
  prescriptionId : string <<FK>>
  sessionNumber : int
  totalSessions : int
  scheduledTime : string
  completedAt : datetime
  status : ExecutionStatus
  date : date
}

User "1" -- "0..*" PhysiotherapyPrescription
PhysiotherapyPrescription "1" -- "0..*" PhysiotherapyExecution : uma sessão por horário
PhysiotherapyExecution --> ExecutionStatus

note right of PhysiotherapyExecution
  "sessionNumber" indica a sessão atual em relação
  a "totalSessions". O timer em tempo real usa
  "holdTimeSeconds" da prescrição.
end note
@enduml
