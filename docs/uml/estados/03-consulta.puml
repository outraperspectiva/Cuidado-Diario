@startuml 03-consulta
title Ciclo de vida de uma consulta (AppointmentStatus)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #103557
  StartColor #103557
  EndColor #103557
}

state "Agendada\n(scheduled)" as A
state "Realizada\n(completed)" as R
state "Cancelada\n(canceled)" as C

[*] --> A : Paciente cadastra a consulta
A --> R : Altera o status para realizada
A --> C : Altera o status para cancelada
R --> [*]
C --> [*]

note right of A
  Ponto em aberto: reabrir ou reagendar
  uma consulta realizada ou cancelada.
end note
@enduml
