@startuml 05-estoque-de-medicamento
title Estados do estoque de um medicamento
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #103557
  StartColor #103557
  EndColor #103557
}

state "Estoque normal" as N
state "Estoque baixo\n(alerta ao usuário)" as B

[*] --> N : Medicamento cadastrado
N --> B : "stock" chega ao valor\nde referência
B --> N : Paciente atualiza o estoque

note right of B
  O valor de referência para "estoque baixo"
  ainda será definido (decisão D2).
end note
@enduml
