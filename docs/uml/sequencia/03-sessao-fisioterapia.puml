@startuml 03-sessao-fisioterapia
title Executar sessão de fisioterapia
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #103557
  ActorBackgroundColor #88C6B0
  ActorBorderColor #103557
  LifeLineBorderColor #103557
  GroupBorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
autonumber

actor Paciente as U
participant "App (React)" as App
database "Banco de dados" as DB

U -> App : Abre a tela de Fisioterapia
App -> DB : Busca as prescrições e sessões do dia
DB --> App : Prescrições e execuções
App --> U : Lista os exercícios do dia
U -> App : Inicia um exercício
loop Para cada série
  App --> U : Exibe o timer (tempo de sustentação)
  U -> App : Conclui a série
end
U -> App : Conclui a sessão
App -> DB : Grava completedAt e status "completed"
DB --> App : Confirmação
App --> U : Atualiza o progresso da sessão
@enduml
