@startuml 04-registrar-dor
title Registrar dor e marcar crise
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #103557
  ActorBackgroundColor #88C6B0
  ActorBorderColor #103557
  LifeLineBorderColor #103557
  GroupBorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
autonumber

actor Paciente as U
participant "App (React)" as App
database "Banco de dados" as DB

U -> App : Abre o registro de dor
App --> U : Mostra a régua de 0 a 10
U -> App : Informa nível, local, tipo e fatores
alt O registro é uma crise
  U -> App : Marca como crise
  App -> DB : Grava painLog com isCrisis = true
else Registro comum
  App -> DB : Grava painLog com isCrisis = false
end
DB --> App : Confirmação
App --> U : Mostra o registro e atualiza o gráfico

note right of App
  Critério de crise a definir (D3).
  Fatores desencadeantes ainda sem
  campo no modelo de dados.
end note
@enduml
