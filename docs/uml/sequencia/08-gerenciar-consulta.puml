@startuml 08-gerenciar-consulta
title Cadastrar consulta e alterar o status
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #103557
  ActorBackgroundColor #88C6B0
  ActorBorderColor #103557
  LifeLineBorderColor #103557
  GroupBorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
autonumber

actor Paciente as U
participant "App (React)" as App
database "Banco de dados" as DB

U -> App : Abre Consultas
App -> DB : Busca as consultas do usuário
DB --> App : Consultas (appointments)
App --> U : Lista as consultas
U -> App : Cadastra médico, especialidade, data, hora e local
App -> DB : Grava a consulta com status "scheduled"
DB --> App : Confirmação
App --> U : Mostra a consulta na lista
U -> App : Altera o status (realizada ou cancelada)
App -> DB : Atualiza o status
DB --> App : Confirmação
App --> U : Atualiza a lista
@enduml
