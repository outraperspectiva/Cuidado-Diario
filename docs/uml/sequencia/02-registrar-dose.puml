@startuml 02-registrar-dose
title Registrar dose como tomada ou pulada
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #103557
  ActorBackgroundColor #88C6B0
  ActorBorderColor #103557
  LifeLineBorderColor #103557
  GroupBorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
autonumber

actor Paciente as U
participant "App (React)" as App
participant "Estado (Redux)" as Store
database "Banco de dados" as DB

U -> App : Abre a tela Hoje
App -> DB : Busca as doses do dia
DB --> App : Doses (medicationIntakes)
App --> U : Mostra os medicamentos do turno
U -> App : Escolhe "Tomada" ou "Pulada"
App -> Store : Atualiza o status da dose
App -> DB : Grava status e takenTime
DB --> App : Confirmação
App --> U : Atualiza o progresso diário
opt Estoque abaixo do valor de referência
  App --> U : Alerta de estoque baixo
end

note right of App
  Valor de "estoque baixo" a definir
  (decisão D2).
end note
@enduml
