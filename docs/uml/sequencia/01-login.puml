@startuml 01-login
title Login com Google e consentimento
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #103557
  ActorBackgroundColor #88C6B0
  ActorBorderColor #103557
  LifeLineBorderColor #103557
  GroupBorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
autonumber

actor Visitante as U
participant "App (React)" as App
participant "Provedor de\nautenticação" as Auth
database "Banco de dados" as DB

U -> App : Toca em "Entrar com Google"
App -> Auth : Inicia a autenticação
Auth --> App : Retorna o usuário autenticado
App -> DB : Busca o perfil (users)
alt Primeiro acesso
  DB --> App : Perfil inexistente
  App -> U : Exibe o consentimento (LGPD)
  U -> App : Aceita
  App -> DB : Cria o perfil e registra o aceite
else Usuário existente
  DB --> App : Perfil encontrado
end
App --> U : Abre a tela Hoje

note right of App
  O modo visitante entra direto
  em demonstração, sem autenticação.
end note
@enduml
