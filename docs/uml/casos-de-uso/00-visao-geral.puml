@startuml 00-visao-geral
title Cuidado Diário: visão geral dos casos de uso
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
left to right direction

actor "Visitante" as V
actor "Paciente" as P
actor "Cuidador" as C
actor "Provedor de autenticação\n(Google / e-mail)" as AUTH <<sistema>>

rectangle "Cuidado Diário" {
  usecase "Acessar o app\n(autenticação e privacidade)" as UC1
  usecase "Ver o painel Hoje" as UC2
  usecase "Gerenciar medicamentos\ne registrar doses" as UC3
  usecase "Executar fisioterapia" as UC4
  usecase "Registrar dor e sintomas" as UC5
  usecase "Acionar SOS Crise" as UC6
  usecase "Acompanhar evolução\ne exportar relatório" as UC7
  usecase "Gerenciar consultas" as UC8
}

V --> UC1
P --> UC1
P --> UC2
P --> UC3
P --> UC4
P --> UC5
P --> UC6
P --> UC7
P --> UC8
UC1 --> AUTH
UC2 ..> UC3 : <<include>>
UC5 ..> UC6 : <<extend>>
C ..> P : <<papel a confirmar>>

note bottom of C
  O papel Cuidador consta no modelo de dados
  (users.role), mas o escopo ainda está em
  aberto (PRD-0001).
end note
@enduml
