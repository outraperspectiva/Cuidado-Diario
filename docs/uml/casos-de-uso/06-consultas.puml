@startuml 06-consultas
title Consultas (PRD-0005)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #103557
skinparam actor {
  BackgroundColor #88C6B0
  BorderColor #103557
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #103557
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #103557
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}
left to right direction

actor "Paciente" as P

rectangle "Cuidado Diário" {
  usecase "Cadastrar consulta" as UC1
  usecase "Editar consulta" as UC2
  usecase "Listar consultas" as UC3
  usecase "Alterar status da consulta" as UC4
  usecase "Marcar como realizada" as UC5
  usecase "Cancelar consulta" as UC6
}

P --> UC1
P --> UC2
P --> UC3
P --> UC4
UC5 --|> UC4
UC6 --|> UC4
@enduml
